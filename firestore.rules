rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Private learned notes: each signed-in user can only access their own memory.
    // The learning API independently checks the configured, verified creator identity.
    match /users/{userId}/knowledge/{noteId} {
      allow get, list: if signedInAs(userId);

      // Structured knowledge records live in Firestore. Older notes without
      // schemaVersion/summary/keywords remain readable and can still be deleted.
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'kind', 'topic', 'title', 'url', 'snippet',
          'summary', 'keyPoints', 'keywords', 'source', 'score', 'savedAt'
        ])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 2
        && request.resource.data.topic.size() <= 180
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 260
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 700
        && (request.resource.data.url == '' || request.resource.data.url.matches('https?://.*'))
        && request.resource.data.snippet is string
        && request.resource.data.snippet.size() <= 3200
        && (!request.resource.data.keys().hasAny(['schemaVersion']) ||
            (request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 2))
        && (!request.resource.data.keys().hasAny(['kind']) ||
            (request.resource.data.kind is string && request.resource.data.kind.size() <= 40))
        && (!request.resource.data.keys().hasAny(['summary']) ||
            (request.resource.data.summary is string && request.resource.data.summary.size() <= 900))
        && (!request.resource.data.keys().hasAny(['keyPoints']) ||
            (request.resource.data.keyPoints is list && request.resource.data.keyPoints.size() <= 5))
        && (!request.resource.data.keys().hasAny(['keywords']) ||
            (request.resource.data.keywords is list && request.resource.data.keywords.size() <= 24))
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 80
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1
        && request.resource.data.savedAt is timestamp;

      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/chats/{chatId} {
      allow get, list: if signedInAs(userId);

      allow create: if signedInAs(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.userMessageCount == 0
        && request.resource.data.status == 'open'
        && request.resource.data.lastUserMessageId == '';

      allow update: if signedInAs(userId) && (
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userMessageCount', 'status', 'lastUserMessageId', 'updatedAt'])
          && request.resource.data.userMessageCount == resource.data.userMessageCount + 1
          && resource.data.userMessageCount < 60
          && request.resource.data.lastUserMessageId is string
          && request.resource.data.lastUserMessageId.size() > 0
          && request.resource.data.status ==
            (request.resource.data.userMessageCount >= 60 ? 'closed' : 'open')
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'updatedAt'])
          && request.resource.data.userMessageCount == resource.data.userMessageCount
          && request.resource.data.status == resource.data.status
          && request.resource.data.lastUserMessageId == resource.data.lastUserMessageId
        )
      );

      allow delete: if signedInAs(userId);

      match /messages/{messageId} {
        allow read: if signedInAs(userId);

        allow create: if signedInAs(userId)
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 30000
          && request.resource.data.createdAt is timestamp
          && (
            (
              request.resource.data.role == 'user'
              && request.resource.data.state == 'pending'
              && getAfter(/databases/$(database)/documents/users/$(userId)/chats/$(chatId))
                .data.userMessageCount ==
                get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId))
                .data.userMessageCount + 1
              && getAfter(/databases/$(database)/documents/users/$(userId)/chats/$(chatId))
                .data.lastUserMessageId == messageId
            )
            ||
            (
              request.resource.data.role == 'assistant'
              && request.resource.data.content.size() <= 25000
              && getAfter(/databases/$(database)/documents/users/$(userId)/chats/$(chatId))
                .data.userMessageCount ==
                get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId))
                .data.userMessageCount
            )
          );

        allow update: if signedInAs(userId)
          && resource.data.role == 'user'
          && resource.data.state == 'pending'
          && request.resource.data.state == 'answered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']);

        allow delete: if signedInAs(userId);
      }
    }
  }
}
