{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fross",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ping",
      "/health",
      "/bot*",
      "/file/*",
      "/webhook*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
